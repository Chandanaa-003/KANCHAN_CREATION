# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/kanchan_creation
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:password@localhost:5432/kanchan_creation

# Security
SECRET_KEY=your-very-long-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Frontend
FRONTEND_URL=http://localhost:3000

# Admin
ADMIN_EMAIL=admin@kanchancreation.com
ADMIN_PASSWORD=ChangeMe@123

# App
APP_ENV=development
